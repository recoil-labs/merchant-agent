# Copy to .env (never commit it) and fill in. Sandbox only: production
# reads secrets from files or a cloud secret manager, not from here.

# From the RecoilPay portal (solver.recoilpay.com): your operator id, the
# wallet you registered with, and the API key shown when you registered.
MERCHANT_AGENT_SOLVER_ID=solver-…
MERCHANT_AGENT_WALLET=0x…
MERCHANT_AGENT_API_KEY=

# The RecoilPay sandbox (testnet). Change only if RecoilPay tells you to.
MERCHANT_AGENT_AGGREGATOR_URL=https://api.recoilpay.com

# Portal → Payouts → "Export payee key": the private key that opens your
# customers' sealed bank details. Treat it like a password.
MERCHANT_AGENT_PAYEE_KEY=

# A random value only this agent knows: `openssl rand -hex 32`.
MERCHANT_AGENT_PAYEE_TAG_PEPPER=
