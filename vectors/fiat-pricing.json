    {
      "name": "design \u00a72 worked example",
      "assetMinorUnits": "100000000",
      "protocolFeeBps": 50,
      "quote": {
        "assetDecimals": 6,
        "fiatCurrency": "NGN",
        "rate": "1520.50",
        "feeFixed": "10000",
        "feeBps": 25,
        "minFiat": "100000",
        "maxFiat": "50000000"
      },
      "protocolFee": "500000",
      "convertible": "99500000",
      "expect": {
        "gross": "15128975",
        "fee": "47823",
        "net": "15081152"
      }
    },
